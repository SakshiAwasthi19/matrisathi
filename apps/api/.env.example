ENV=development

# ---------------------------------------------------------------------------
# Database — choose ONE of the two blocks below and comment out the other.
# ---------------------------------------------------------------------------

# Option A: local Docker Postgres (infra/docker-compose.yml). Good for
# solo/offline work; each developer has their own throwaway data.
DATABASE_URL_MIGRATOR=postgresql+psycopg://matrisathi_migrator:matrisathi_migrator_dev_pw@localhost:5433/matrisathi
DATABASE_URL_APP=postgresql+psycopg://matrisathi_app:matrisathi_app_dev_pw@localhost:5433/matrisathi

# Option B: shared team Supabase project (one Postgres database everyone's
# local API instance points at). See README.md "Shared team database
# (Supabase)" for the one-time setup (creating the matrisathi_migrator /
# matrisathi_app roles) that only needs to happen once, by whoever sets the
# project up — not by every teammate.
#
# Get these from the Supabase dashboard: Project Settings -> Database ->
# Connection string. Use the SESSION-mode pooler (port 5432 on the
# aws-0-<region>.pooler.supabase.com host) — NOT the "Direct connection"
# (db.[PROJECT-REF].supabase.co), which is IPv6-only and unreachable from
# many networks; and NOT the transaction-mode pooler on port 6543, which
# doesn't reliably support the DDL migrations run (CREATE ROLE, etc.).
# Session-mode pooler username format is "<role>.<project-ref>":
#
# DATABASE_URL_MIGRATOR=postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_URL_APP=postgresql+psycopg://matrisathi_app.[PROJECT-REF]:[MATRISATHI_APP-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# The matrisathi_app role above is created automatically by
# alembic/versions/0002_app_role_grants.py the first time migrations run —
# nobody creates it by hand. Its password defaults to a value committed in
# that file (fine for local-only Postgres, not fine for an internet-
# reachable one like Supabase) unless you override it here — set this
# BEFORE running `alembic upgrade head` against Supabase the first time,
# and use the same [MATRISATHI_APP-PASSWORD] in DATABASE_URL_APP above:
# MATRISATHI_APP_DB_PASSWORD=[MATRISATHI_APP-PASSWORD]
#
# Optional, only if some future feature uses the Supabase client SDK
# directly (nothing in this app reads these yet — the app only ever talks
# to Postgres via the two URLs above):
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# App role is restricted at the database level: no DDL, and INSERT/SELECT
# only (no UPDATE/DELETE) on audit_event. See alembic/versions/0002_*.py.
# This holds for either database option above.

# Dev-only secret. Never reuse in a real deployment. Each developer keeps
# their own — it does not need to match teammates' even when sharing a
# database, since each person's browser only ever talks to their own
# locally-running API process.
JWT_SECRET=dev-only-secret-change-me

# Comma-separated if more than one (e.g. adding a staging frontend URL
# alongside local dev during testing).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local dev (frontend and backend share localhost): leave both as below.
# A staging deployment with frontend and backend on DIFFERENT domains
# (e.g. Vercel + Render) is cross-site as far as cookies are concerned —
# set COOKIE_SECURE=true and COOKIE_SAMESITE=none there (both required
# together; browsers reject SameSite=None without Secure).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Private file storage. "local" (development only) writes under
# FILE_STORE_LOCAL_ROOT (gitignored .data/files). Staging and anything beyond
# must use "supabase" with SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY set; the
# API refuses to start otherwise (docs/delivery/staging.md).
FILE_STORE_BACKEND=local
FILE_STORE_LOCAL_ROOT=.data/files

# WhatsApp messaging (SG3). "disabled" (default) sends nothing and the webhook
# answers 503. "meta" uses the WhatsApp Cloud API (D06 is not decided yet:
# provider sandbox / test number only). With "meta", all three secrets are
# required or the API refuses to start outside development. Set the secrets
# in the host's environment settings only — never in a file in git.
MESSAGING_PROVIDER=disabled
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
# Placeholder templates may be sent only to consenting staff test phones.
MESSAGING_ALLOW_PLACEHOLDER_TEMPLATES=false
# MESSAGING_DEFAULT_COUNTRY_CODE=91
# MESSAGING_DEFAULT_SAFE_FROM_HOUR=8
# MESSAGING_DEFAULT_SAFE_TO_HOUR=20
# INBOX_RESPONSE_HOURS=24

# ---------------------------------------------------------------------------
# GitHub — NOT read by this application. Nothing in apps/api/app imports or
# calls GitHub's API; this exists only as a convenience if you want to
# script repo setup locally (e.g. `git remote set-url origin
# https://$GITHUB_TOKEN@github.com/<org>/<repo>.git`).
#
# For actually authenticating `git`/`gh` against GitHub, prefer `gh auth
# login` or an SSH key over a long-lived token sitting in a file — neither
# of those touches this .env at all. If you do keep a token here, scope it
# to the minimum (repo access only) and rotate it if it's ever pasted
# anywhere outside this file (chat, a screenshot, a log).
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
